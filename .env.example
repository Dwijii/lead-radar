# --- Freelancer.com ---
# Generate at https://developers.freelancer.com (Account > API tokens)
FREELANCER_OAUTH_TOKEN=

# Point at the sandbox while testing: https://www.freelancer-sandbox.com
FREELANCER_BASE_URL=https://www.freelancer.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Scoring ---
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-sonnet-5-5

# --- Where qualified leads get written: sheets | notion | both ---
LEAD_DESTINATION=sheets

# Google Sheets (share the sheet with the service account email as Editor)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Notion (only if LEAD_DESTINATION includes notion)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Protects the cron endpoint. Any long random string.
CRON_SECRET=
